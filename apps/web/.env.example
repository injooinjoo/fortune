# Ondo Web (@fortune/web) 환경변수
#
# 전부 NEXT_PUBLIC_* — 브라우저 번들에 인라인된다.
# SUPABASE_SERVICE_ROLE_KEY 는 이 앱에서 절대 사용하지 않는다.
# 서버 권한이 필요한 동작은 Supabase Edge Function 이 담당한다.

# Supabase 프로젝트 URL (예: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 배포 도메인. 이메일 로그인 redirect / robots / sitemap 의 절대 URL 기준.
# 로컬 개발 기본값: http://localhost:3100
#
# ⚠️ 런타임이 아니라 *빌드 타임* 에 반드시 설정돼 있어야 한다.
# NEXT_PUBLIC_* 는 번들에 인라인되고, /robots.txt 와 /sitemap.xml 은 정적
# prerender 대상이라 빌드 시점 값이 그대로 파일에 굳는다. 미설정 상태로
# 배포하면 실제로 아래가 나간다 (검증 완료):
#   - robots.txt   → `Sitemap: http://localhost:3100/sitemap.xml`
#   - sitemap.xml  → `<loc>http://localhost:3100</loc>`
#   - 매직링크 메일의 emailRedirectTo → http://localhost:3100/auth/callback
#     (= 프로덕션 로그인이 통째로 깨진다)
# Vercel 에서는 Production/Preview 각 환경에 값을 넣고 재빌드할 것.
NEXT_PUBLIC_SITE_URL=
